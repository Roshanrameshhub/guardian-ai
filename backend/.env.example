# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
APP_DEBUG=true

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://guardian:guardian_pass@localhost:5432/guardian_ai

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret-min-32-chars-use-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-separate-key
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Apple Sign In (optional) ────────────────────────────────────────────────
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ─── Maps / Routing ───────────────────────────────────────────────────────────
# Google Maps API key (for Google Directions API real route calculations)
# If empty, maps endpoint returns ServiceUnavailableError (never returns fake routes)
MAPS_API_KEY=

# ─── Weather ─────────────────────────────────────────────────────────────────
# OpenWeatherMap API key (for live atmospheric telemetry)
# If empty, weather endpoint returns truthful unavailable state (never returns fake 31°C)
WEATHER_API_KEY=
WEATHER_CACHE_TTL_SECONDS=600

# ─── AI Safety Assistant ─────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_CONTEXT_TOKENS=2000

# ─── Push Notifications (Firebase Cloud Messaging HTTP v1) ──────────────────
# Path to backend Firebase Service Account JSON key (e.g., ./secrets/guardian-ai-firebase-adminsdk.json)
# or raw JSON string content of the service account.
# Fallback: Uses GOOGLE_APPLICATION_CREDENTIALS / Application Default Credentials if unset.
FIREBASE_SERVICE_ACCOUNT_KEY=


# ─── SMS (Twilio) ────────────────────────────────────────────────────────────
# Twilio credentials for real emergency SOS SMS dispatch
# If empty, SMS delivery is recorded and marked unconfigured (never falsified)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@guardian.ai

# ─── Safety Data ─────────────────────────────────────────────────────────────
SAFETY_DATA_API_KEY=
SAFETY_DATA_BASE_URL=

# ─── Guardian Watchdog ───────────────────────────────────────────────────────
GUARDIAN_HEARTBEAT_TIMEOUT_SECONDS=120
GUARDIAN_GRACE_PERIOD_SECONDS=60

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SOS_PER_MINUTE=5
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_LOCATION_PER_MINUTE=120
